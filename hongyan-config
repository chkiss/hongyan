#!/usr/bin/env python3
"""hongyan-config — everything about the Hongyan bot's config in one place.

Single-file, stdlib only. No arguments starts the menu: services &
permissions, Signal/API basics, auto-update. Subcommands for scripting.

Two permissions per service, toggled separately:
  see     the bot reports the service's state (status, probes)
  restart the bot restarts it on request (implies see)

The menu keeps one stable list: everything the bot knows about — configured
services, plus everything a scan has ever found (remembered in config as
_known_services, which the listener ignores). 's' writes; 'q' or Ctrl-C
discards unsaved changes.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

CONFIG_PATH = os.path.expanduser("~/.config/hongyan/config.json")
STATE_DIR = os.path.dirname(CONFIG_PATH)
IS_WINDOWS = sys.platform.startswith("win")

UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                     r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
E164_RE = re.compile(r"^\+[1-9][0-9]{7,14}$")

_USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code, text):
    return "\033[%sm%s\033[0m" % (code, text) if _USE_COLOR else text


def load():
    with open(CONFIG_PATH) as fh:
        return json.load(fh)


def save(cfg):
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(cfg, fh, indent=2, ensure_ascii=False)
    os.replace(tmp, CONFIG_PATH)
    print("Saved %s — restart the listener to apply." % CONFIG_PATH)


def run(cmd, timeout=30):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True,
                          timeout=timeout, stdin=subprocess.DEVNULL)


# ── service detection ────────────────────────────────────────────────────────
def detect():
    """Running services on this machine, noise-filtered."""
    out = []
    if IS_WINDOWS:
        cmd = ("powershell -NoProfile -Command \"Get-Service | Where-Object "
               "{$_.StartType -eq 'Automatic' -and $_.Status -eq 'Running'} | "
               "Select-Object -First 20 -ExpandProperty Name\"")
        for line in run(cmd).stdout.splitlines():
            if line.strip():
                out.append((line.strip(), "windows", line.strip()))
        return out
    noise = re.compile(
        r"^(systemd|getty|serial-getty|user@|session-|dbus|polkit|accounts-|"
        r"irqbalance|atd|udisks|upower|cups|ModemManager|NetworkManager|"
        r"rsyslog|cron|anacron|logrotate|e2scrub|fstrim|man-db|fwupd|"
        r"packagekit|unattended|qemu|cloud-init|snapd|multipathd|lvm2|"
        r"open-iscsi|ssh|sshd)")
    for cmd, kind in (
            ("systemctl list-units --type=service --state=running --no-legend "
             "--plain 2>/dev/null | awk '{print $1}'", "system"),
            ("systemctl --user list-units --type=service --state=running "
             "--no-legend --plain 2>/dev/null | awk '{print $1}'", "user")):
        for line in run(cmd).stdout.splitlines():
            unit = line.strip()
            if unit.endswith(".service"):
                unit = unit[:-8]
            if unit and (kind == "user" or not noise.match(unit)):
                out.append((unit, kind, unit))
    return out[:20]


# ── services model ───────────────────────────────────────────────────────────
def known_map(cfg):
    """key -> [kind, target] for everything the bot has ever been shown.

    Configured services come first (they are the truth), then the _known
    catalog remembered from past scans — the listener ignores underscore
    keys, so this is config-tool memory, not bot behaviour.
    """
    known = {}
    for key, spec in (cfg.get("_known_services") or {}).items():
        known[key] = [spec.get("type", "system"), spec.get("unit") or key]
    for key, spec in (cfg.get("services") or {}).items():
        if isinstance(spec, dict):
            kind = spec.get("type", "system")
            target = spec.get("port") if kind == "port" else spec.get("unit")
            known[key] = [kind, target or key]
        else:
            known[key] = [spec[0], spec[1]]
    return known


def see_set(cfg):
    return set(cfg.get("services") or [])


def restart_set(cfg):
    return set(cfg.get("allowed_units") or []) & see_set(cfg)


def apply_state(cfg, known, see, restart):
    """Write services + allowed_units from the permission state, keep _known."""
    restart = restart & see   # cannot restart what the bot cannot see
    cfg["services"] = {k: {"type": known[k][0], "unit": known[k][1]}
                       for k in sorted(see) if k in known}
    cfg["allowed_units"] = sorted(restart)
    cfg["_known_services"] = {k: {"type": v[0], "unit": v[1]}
                              for k, v in sorted(known.items())}
    cfg["onboarding_done"] = True


def sync_from_config(cfg, known):
    """Configured services win over remembered-but-disabled catalog entries."""
    for key, spec in (cfg.get("services") or {}).items():
        if isinstance(spec, dict):
            kind = spec.get("type", "system")
            target = spec.get("port") if kind == "port" else spec.get("unit")
            known[key] = [kind, target or key]
        else:
            known[key] = [spec[0], spec[1]]


# ── services screen ──────────────────────────────────────────────────────────
def services_screen(cfg):
    known = known_map(cfg)
    sync_from_config(cfg, known)
    see = see_set(cfg)
    restart = restart_set(cfg)
    dirty = False

    def draw():
        run("cls" if IS_WINDOWS else "clear")
        star = _c("33", " *unsaved*") if dirty else ""
        print(_c("1", "Hongyan services — pick what it may see and restart")
              + star)
        print(_c("3", "config: %s" % CONFIG_PATH))
        print()
        print("   #  see  restart  service")
        for i, key in enumerate(sorted(known), 1):
            kind, target = known[key]
            s_mark = _c("32", "[x]") if key in see else _c("90", "[ ]")
            r_mark = _c("32", "[x]") if key in restart else _c("90", "[ ]")
            key_s = key if key in see else _c("90", key)
            print("  %2d  %s    %s       %-22s %-8s %s"
                  % (i, s_mark, r_mark, key_s, kind, target))
        print()
        print("  <n> cycle: off → see → see + restart    r refresh    "
              "n add by hand")
        print("  s save   q quit without saving")
        print(_c("3", "  see = the bot reports this service's state (status, "
                 "probes)"))
        print(_c("3", "  restart = the bot restarts it when you ask "
                 "(includes see)"))

    while True:
        draw()
        try:
            choice = input("> ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            choice = "q"
        if choice in ("q", "^c"):
            if dirty and not _confirm_discard():
                continue
            print("Bye! Unsaved changes discarded." if dirty else "Bye!")
            return
        if choice == "s":
            apply_state(cfg, known, see, restart)
            save(cfg)
            dirty = False
            continue
        if choice == "r":
            fresh = 0
            for key, kind, target in detect():
                if key not in known:
                    known[key] = [kind, target]
                    see.add(key)
                    restart.add(key)
                    fresh += 1
            if fresh:
                dirty = True
                print(_c("32", "  Added %d new service(s) (see + restart)."
                         % fresh))
            else:
                print("  Nothing new running.")
            continue
        if choice == "n":
            parts = input("  name kind target: ").split()
            if len(parts) == 3:
                known[parts[0]] = [parts[1], parts[2]]
                see.add(parts[0])
                restart.add(parts[0])
                dirty = True
            continue
        if choice.isdigit():
            keys = sorted(known)
            idx = int(choice)
            if not 1 <= idx <= len(keys):
                continue
            key = keys[idx - 1]
            # cycle: off -> see -> see + restart -> off
            if key not in see:
                see.add(key)
            elif key not in restart:
                restart.add(key)
            else:
                see.discard(key)
                restart.discard(key)
            dirty = True


def _confirm_discard():
    try:
        reply = input("  Unsaved changes — discard? [y/N] ").strip().lower()
    except (KeyboardInterrupt, EOFError):
        return True
    return reply.startswith("y")


# ── basics screen ────────────────────────────────────────────────────────────
def _key_path(cfg):
    return cfg.get("key_file") or os.path.join(STATE_DIR, "zen.key")


def basics_fields(cfg):
    return [
        ("transport", "transport (bot_account | note_to_self)",
         cfg.get("transport", "bot_account"),
         lambda v: v in ("bot_account", "note_to_self"),
         "bot_account or note_to_self"),
        ("bot_number", "the BOT's own Signal number",
         cfg.get("bot_number", ""), lambda v: bool(E164_RE.match(v)),
         "+E.164, e.g. +15550000002 — must differ from owner_number"),
        ("owner_number", "your phone number",
         cfg.get("owner_number", ""), lambda v: bool(E164_RE.match(v)),
         "+E.164, e.g. +15550000001"),
        ("owner_aci", "your ACI (the only key that authorizes you)",
         cfg.get("owner_aci", ""), lambda v: bool(UUID_RE.match(v)),
         "UUID, e.g. 3f2504e0-4f89-11d3-9a0c-0305e82c3301"),
        ("api_base", "model API base URL",
         cfg.get("api_base", ""), lambda v: v.startswith("http"),
         "https://..."),
        ("site_label", "label the bot uses for this machine",
         (cfg.get("site") or {}).get("label", ""), lambda v: True, "free text"),
    ]


def basics_screen(cfg):
    while True:
        run("cls" if IS_WINDOWS else "clear")
        print(_c("1", "Hongyan basics — Signal identity and model API"))
        print(_c("3", "config: %s" % CONFIG_PATH))
        print()
        fields = basics_fields(cfg)
        for i, (key, label, val, _ok, _hint) in enumerate(fields, 1):
            shown = val if val else _c("90", "(not set)")
            print("  %d %-46s %s" % (i, label + ":", shown))
        key_p = _key_path(cfg)
        have_key = os.path.exists(key_p)
        print("  k  api key file                            %s (%s)"
              % (key_p, _c("32", "present") if have_key
                 else _c("33", "not set")))
        print()
        print("  <n> edit    k set api key    s save    q back")
        print(_c("3", "  transport note_to_self links hongyan as a device on "
                 "YOUR account — it sees every conversation. bot_account is a "
                 "separate number."))
        try:
            choice = input("basics> ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            return
        if choice == "q":
            return
        if choice == "s":
            save(cfg)
            continue
        if choice == "k":
            key = input("  API key (Enter to cancel): ").strip()
            if key:
                with open(key_p, "w") as fh:
                    fh.write(key)
                os.chmod(key_p, 0o600)
                cfg["key_file"] = key_p
                print(_c("32", "  key written (%s, mode 600)" % key_p))
            continue
        if choice.isdigit() and 1 <= int(choice) <= len(fields):
            key, label, _val, ok, hint = fields[int(choice) - 1]
            val = input("  %s [%s]: " % (label, _val)).strip()
            if not val:
                continue
            if not ok(val):
                print(_c("33", "  %s" % hint))
                input("  Enter to continue ")
                continue
            if key == "site_label":
                cfg.setdefault("site", {})["label"] = val
            else:
                cfg[key] = val.lower() if key == "owner_aci" else val
            print(_c("32", "  set (unsaved)"))


# ── auto-update toggle ───────────────────────────────────────────────────────
AUTO_CRON = "hongyan-autoupdate"


def autoupdate_state():
    if IS_WINDOWS:
        return "unsupported"
    cur = subprocess.run("crontab -l 2>/dev/null", shell=True,
                         capture_output=True, text=True,
                         stdin=subprocess.DEVNULL).stdout
    return "on" if AUTO_CRON in cur else "off"


def autoupdate_set(on, lines=None):
    """Add/remove the autoupdate cron line. `lines` overrides the crontab
    content (for testing). Returns the new crontab content."""
    if lines is None:
        lines = subprocess.run("crontab -l 2>/dev/null", shell=True,
                               capture_output=True, text=True,
                               stdin=subprocess.DEVNULL).stdout
    kept = []
    for line in lines.splitlines():
        if AUTO_CRON in line:
            if kept and kept[-1].lstrip().startswith("#"):
                kept.pop()           # its comment line goes too
            continue
        kept.append(line)
    if on:
        exe = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                           AUTO_CRON)
        if not os.path.exists(exe):
            exe = os.path.expanduser("~/.local/bin/" + AUTO_CRON)
        kept += ["", "# Fast-forward to origin/main when tests pass",
                 "*/15 * * * * %s" % exe]
    new = "\n".join(kept).lstrip("\n")
    if not new.endswith("\n"):
        new += "\n"
    if lines is None:
        p = subprocess.run("crontab -", shell=True, input=new,
                           capture_output=True, text=True,
                           stdin=subprocess.DEVNULL)
        if p.returncode:
            print(_c("31", "  crontab write failed: %s" % p.stderr.strip()))
            return lines
    return new


def autoupdate_screen(cfg):
    while True:
        state = autoupdate_state()
        print()
        print("  auto-update: %s" % _c("32" if state == "on" else "33", state))
        print(_c("3", "  on = cron every 15 min: git fast-forward to "
                 "origin/main when the test suite passes. Silent on success,"))
        print(_c("3", "  alerts over Signal on failure. Linux only — on "
                 "Windows, pull manually."))
        try:
            choice = input("  t toggle   q back [autoupdate> ]: ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            return
        if choice in ("q", ""):
            return
        if choice == "t":
            if IS_WINDOWS or state == "unsupported":
                print(_c("33", "  Not supported on this platform."))
                input("  Enter to continue ")
                continue
            autoupdate_set(state != "on")
            print(_c("32", "  auto-update is now %s" % autoupdate_state()))


# ── main menu ────────────────────────────────────────────────────────────────
# ── install flow (ported from install.sh — one implementation, one entry) ───
def is_installed():
    return os.path.exists(CONFIG_PATH)


def repo_dir():
    return os.path.dirname(os.path.realpath(__file__))


def bin_dir():
    return os.path.expanduser("~/.local/bin")


def cron_lines():
    return subprocess.run("crontab -l 2>/dev/null", shell=True,
                          capture_output=True, text=True,
                          stdin=subprocess.DEVNULL).stdout


def add_cron(schedule, command, comment):
    current = cron_lines()
    if command in current:
        print("  cron already has: %s" % command)
        return
    lines = [l for l in current.splitlines()]
    lines += ["# " + comment, schedule + " " + command]
    subprocess.run("crontab -", shell=True, input="\n".join(lines) + "\n",
                   capture_output=True, text=True, stdin=subprocess.DEVNULL)
    print("  cron: %s %s" % (schedule, command))


def _ask(prompt, default=""):
    suffix = " [%s]: " % default if default else ": "
    val = input("  " + prompt + suffix).strip()
    return val or default


def _ask_valid(prompt, pattern, hint, default=""):
    for _ in range(3):
        val = _ask(prompt, default)
        if re.match(pattern, val):
            return val
        print("  " + hint)
    if _confirm("Use %r anyway?" % val):
        return val
    return _ask_valid(prompt, pattern, hint, default)


def _confirm(prompt, default=False):
    suffix = " [Y/n]: " if default else " [y/N]: "
    try:
        reply = input("  %s%s" % (prompt, suffix)).strip().lower()
    except (KeyboardInterrupt, EOFError):
        return False
    if not reply:
        return default
    return reply.startswith("y")


NOTE_TO_SELF_WARNING = """
  READ THIS BEFORE CHOOSING NOTE TO SELF

  hongyan would be linked as a device on your own Signal account, the same
  way Signal Desktop is. A linked device receives a copy of EVERY
  conversation you have — not just Note to Self — and can send messages as
  you, to anyone.

  If this server is compromised, your whole Signal identity goes with it.

  With a separate bot account, the worst case is a spare number that only
  ever talks to you.
"""


def install_flow():
    repo = repo_dir()
    print(_c("1", "Hongyan installer"))
    if IS_WINDOWS:
        print(_c("33", "  Windows: signal-cli and Java setup is manual — see "
                 "INSTALL-WINDOWS.md in %s" % repo))
        print(_c("33", "  This flow will create the config and pick services; "
                 "scheduled tasks are in the doc."))
    shape = _ask("Setup — one device, or server + review host? (1/2)", "1")
    if shape in ("2", "two", "Two", "TWO"):
        role = _ask("Which machine is this? (s=server / r=review host)", "s")
        if role in ("r", "R", "review"):
            script = os.path.join(repo, "install-review-host.sh")
            if os.path.exists(script):
                os.system('bash "%s"' % script)
            else:
                os.system('curl -fsSL https://raw.githubusercontent.com/chkiss/'
                          'hongyan/main/install-review-host.sh | bash')
            return

    if not IS_WINDOWS:
        print("  Checking prerequisites")
        if not os.path.exists("/usr/bin/signal-cli") and not shutil.which("signal-cli") \
                and not os.path.exists(os.path.expanduser("~/.local/bin/signal-cli")):
            print(_c("33", "  ! signal-cli not found — install it from "
                     "github.com/AsamK/signal-cli and register the BOT's number "
                     "before starting."))
        else:
            print(_c("32", "  ok signal-cli found"))
    os.makedirs(STATE_DIR, exist_ok=True)
    if not IS_WINDOWS:
        os.makedirs(bin_dir(), exist_ok=True)

    # config: keep, backup+recreate, or create fresh
    if is_installed():
        if _confirm("Config already exists — keep it as is?"):
            print("  keeping existing config")
        else:
            bak = CONFIG_PATH + ".bak-" + time.strftime("%F-%H%M%S")
            os.replace(CONFIG_PATH, bak)
            print("  backed up existing config to " + bak)
            _fresh_config(repo)
    else:
        _fresh_config(repo)

    cfg = load()

    # transport decision with the full warning (mirrors the old installer)
    if cfg.get("transport", "bot_account") == "note_to_self":
        print(NOTE_TO_SELF_WARNING)
        if not _confirm("I understand, and want Note to Self anyway"):
            cfg["transport"] = "bot_account"
            print("  Keeping the separate bot account. Good call.")

    # identity: the basics screen, then hard-validate what the bot needs
    while True:
        basics_screen(cfg)
        missing = []
        if not UUID_RE.match(str(cfg.get("owner_aci", ""))):
            missing.append("owner_aci (your UUID)")
        if not E164_RE.match(str(cfg.get("owner_number", ""))):
            missing.append("owner_number (your E.164 number)")
        if cfg.get("transport", "bot_account") == "bot_account" and \
                not E164_RE.match(str(cfg.get("bot_number", ""))):
            missing.append("bot_number (the bot's own E.164 number)")
        if not missing:
            break
        print(_c("33", "  Still missing/invalid: %s" % "; ".join(missing)))

    # services: the scan-and-toggle screen
    services_screen(cfg)
    cfg = load()

    # link commands + cron (Linux only; Windows uses scheduled tasks per doc)
    if not IS_WINDOWS:
        print("  Linking commands into " + bin_dir())
        for f in ("hongyan_listener.py", "hongyan-lib.sh", "hongyan-supervise",
                  "hongyan-watchdog", "hongyan-autoupdate", "hongyan-send.py",
                  "hongyan-me", "hongyan-monthly-review", "hongyan-stt",
                  "hongyan-config"):
            src_f = os.path.join(repo, f)
            if not os.path.exists(src_f):
                continue
            dst = os.path.join(bin_dir(), f)
            if os.path.exists(dst) and not os.path.islink(dst):
                os.replace(dst, dst + ".pre-install")
                print("  moved existing %s to %s.pre-install" % (f, f))
            if os.path.islink(dst):
                os.remove(dst)
            os.symlink(src_f, dst)
            os.chmod(src_f, 0o755)
        print(_c("32", "  symlinked to the repository — git pull updates the "
                 "running system"))

        print("  Scheduling")
        if _confirm("Install the keep-alive cron (start at boot + watchdog)?", True):
            add_cron("@reboot", "sleep 30 && %s/hongyan-supervise" % bin_dir(),
                     "Start at boot")
            add_cron("*/10 * * * *", "%s/hongyan-watchdog --restart" % bin_dir(),
                     "Quiet restart if it dies")
            add_cron("23 8 * * *", "%s/hongyan-watchdog --daily" % bin_dir(),
                     "Daily health check")
        if _confirm("Pull updates from GitHub automatically (every 15 min)?", True):
            autoupdate_set(True)
            print("  Silent on success; alerts over Signal if an update fails.")
        else:
            print("  Update by hand with: git -C %s pull" % repo)

    print("  Running the test suite")
    tests = os.path.join(repo, "tests", "test_listener.py")
    t = subprocess.run([sys.executable, tests], capture_output=True,
                       text=True, stdin=subprocess.DEVNULL)
    print(_c("32", "  ok test suite passes") if t.returncode == 0
          else _c("33", "  ! test suite failed — run it to see why"))

    print()
    print(_c("1", "Install complete."))
    if not IS_WINDOWS:
        print("  Start it with: %s/hongyan-supervise" % bin_dir())
    print("  Then text the bot 'status' from the phone whose ACI you configured.")
    print("  Re-run hongyan-config any time to tune services or basics.")


def _fresh_config(repo):
    example = os.path.join(repo, "config.example.json")
    cfg = {}
    if os.path.exists(example):
        with open(example) as fh:
            cfg = json.load(fh)
    # a fresh install describes no services yet: the scan and the owner do that
    cfg["services"] = {}
    cfg["allowed_units"] = []
    cfg.pop("_known_services", None)
    cfg["onboarding_done"] = False
    save(cfg)


def main_menu():
    while True:
        run("cls" if IS_WINDOWS else "clear")
        print(_c("1", "Hongyan config"))
        print(_c("3", "config: %s" % CONFIG_PATH))
        print()
        print("  3  services & permissions   (what the bot may see/restart)")
        print("  2  Signal & API basics      (numbers, ACI, transport, key)")
        print("  1  auto-update              (cron fast-forward, Linux)")
        print("  q  quit")
        try:
            choice = input("> ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            return
        if choice == "q":
            print("Bye!")
            return
        if choice == "3":
            services_screen(load())
        elif choice == "2":
            basics_screen(load())
        elif choice == "1":
            autoupdate_screen(load())


# ── CLI ──────────────────────────────────────────────────────────────────────
def cli(argv):
    if argv[:1] == ["path"]:
        print(CONFIG_PATH)
        return 0
    if argv[:1] == ["list"]:
        cfg = load()
        known = known_map(cfg)
        see, restart = see_set(cfg), restart_set(cfg)
        print("config: %s" % CONFIG_PATH)
        for key in sorted(known):
            kind, target = known[key]
            print("  see [%s]  restart [%s]  %-22s %-8s %s"
                  % ("x" if key in see else " ", "x" if key in restart else " ",
                     key, kind, target))
        return 0
    if argv[:1] == ["detect"]:
        for key, kind, target in detect():
            print("  %-22s %-8s %s" % (key, kind, target))
        return 0
    if argv[:1] == ["basics"]:
        cfg = load()
        for key, label, val, _ok, _hint in basics_fields(cfg):
            print("%-14s %s" % (key + ":", val or "(not set)"))
        print("key_file       %s" % _key_path(cfg))
        return 0
    if argv[:1] == ["autoupdate"]:
        if argv[1:2] == ["on"] or argv[1:2] == ["off"]:
            autoupdate_set(argv[1] == "on")
            print("auto-update: %s" % autoupdate_state())
        else:
            print("auto-update: %s" % autoupdate_state())
        return 0

    cfg = load()
    known = known_map(cfg)
    see, restart = see_set(cfg), restart_set(cfg)

    if argv[:1] in (["enable"], ["see"], ["restart"]):
        mode = argv[0]
        if len(argv) < 2:
            print("usage: hongyan-config %s NAME [KIND] [TARGET]" % mode); return 2
        key = argv[1]
        known[key] = [argv[2] if len(argv) > 2 else known.get(key, ["system"])[0],
                      argv[3] if len(argv) > 3 else known.get(key, ["", key])[1]]
        see.add(key)
        if mode in ("enable", "restart"):
            restart.add(key)
        apply_state(cfg, known, see, restart)
        save(cfg)
        return 0
    if argv[:1] == ["disable"]:
        if len(argv) < 2:
            print("usage: hongyan-config disable NAME"); return 2
        see.discard(argv[1])
        restart.discard(argv[1])
        apply_state(cfg, known, see, restart)
        save(cfg)
        return 0
    print("usage: hongyan-config [list|detect|basics|autoupdate on|off|"
          "enable NAME [KIND] [TARGET]|see NAME|restart NAME|disable NAME|path]\n"
          "no subcommand starts the interactive menu")
    return 2


if __name__ == "__main__":
    if "--install" in sys.argv[1:]:
        install_flow()
    elif len(sys.argv) <= 1:
        if is_installed():
            main_menu()
        else:
            print(_c("33", "Hongyan is not installed on this machine yet."))
            install_flow()
    else:
        sys.exit(cli(sys.argv[1:]))
