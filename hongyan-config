#!/usr/bin/env python3
"""hongyan-config — toggle what the hongyan bot may see and touch.

Single-file, stdlib only. Run with no arguments for the interactive menu;
subcommands for scripting.

The menu keeps one stable list: everything the bot knows about — configured
services, plus everything a scan has ever found (remembered in config as
_known_services, which the listener ignores). Toggles flip [x]/[ ] without
removing rows; 's' writes; 'q' or Ctrl-C discards unsaved changes.
"""
import json
import os
import re
import subprocess
import sys

CONFIG_PATH = os.path.expanduser("~/.config/hongyan/config.json")
IS_WINDOWS = sys.platform.startswith("win")

_USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code, text):
    return "\033[%sm%s\033[0m" % (code, text) if _USE_COLOR else text


def load():
    with open(CONFIG_PATH) as fh:
        return json.load(fh)


def save(cfg):
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(cfg, fh, indent=2, ensure_ascii=False)
    os.replace(tmp, CONFIG_PATH)


def detect():
    """Running services on this machine, noise-filtered."""
    out = []
    if IS_WINDOWS:
        cmd = ("powershell -NoProfile -Command \"Get-Service | Where-Object "
               "{$_.StartType -eq 'Automatic' -and $_.Status -eq 'Running'} | "
               "Select-Object -First 20 -ExpandProperty Name\"")
        for line in subprocess.run(cmd, shell=True, capture_output=True,
                                   text=True, timeout=30).stdout.splitlines():
            if line.strip():
                out.append((line.strip(), "windows", line.strip()))
        return out
    noise = re.compile(
        r"^(systemd|getty|serial-getty|user@|session-|dbus|polkit|accounts-|"
        r"irqbalance|atd|udisks|upower|cups|ModemManager|NetworkManager|"
        r"rsyslog|cron|anacron|logrotate|e2scrub|fstrim|man-db|fwupd|"
        r"packagekit|unattended|qemu|cloud-init|snapd|multipathd|lvm2|"
        r"open-iscsi|ssh|sshd)")
    cmd = ("systemctl list-units --type=service --state=running --no-legend "
           "--plain 2>/dev/null | awk '{print $1}'")
    for line in subprocess.run(cmd, shell=True, capture_output=True,
                               text=True, timeout=20).stdout.splitlines():
        unit = line.strip()
        if unit.endswith(".service"):
            unit = unit[:-8]
        if unit and not noise.match(unit):
            out.append((unit, "system", unit))
    cmd = ("systemctl --user list-units --type=service --state=running "
           "--no-legend --plain 2>/dev/null | awk '{print $1}'")
    for line in subprocess.run(cmd, shell=True, capture_output=True,
                               text=True, timeout=20).stdout.splitlines():
        unit = line.strip()
        if unit.endswith(".service"):
            unit = unit[:-8]
        if unit:
            out.append((unit, "user", unit))
    return out[:20]


def known_map(cfg):
    """key -> [kind, target] for everything the bot has ever been shown.

    Configured services come first (they are the truth), then the _known
    catalog remembered from past scans — the listener ignores underscore
    keys, so this is TUI memory, not bot behaviour.
    """
    known = {}
    for key, spec in (cfg.get("_known_services") or {}).items():
        known[key] = [spec.get("type", "system"), spec.get("unit") or key]
    for key, spec in (cfg.get("services") or {}).items():
        if isinstance(spec, dict):
            kind = spec.get("type", "system")
            target = spec.get("port") if kind == "port" else spec.get("unit")
            known[key] = [kind, target or key]
        else:
            known[key] = [spec[0], spec[1]]
    return known


def enabled_set(cfg):
    return set(cfg.get("allowed_units") or []) & set(cfg.get("services") or {})


def apply_state(cfg, known, enabled):
    """Write services + allowed_units from the toggle state, keep _known."""
    cfg["services"] = {k: {"type": known[k][0], "unit": known[k][1]}
                       for k in sorted(enabled) if k in known}
    cfg["allowed_units"] = sorted(enabled)
    cfg["_known_services"] = {k: {"type": v[0], "unit": v[1]}
                              for k, v in sorted(known.items())}
    cfg["onboarding_done"] = True


def sync_from_config(cfg, known):
    """Configured services win over remembered-but-disabled catalog entries."""
    for key, spec in (cfg.get("services") or {}).items():
        if isinstance(spec, dict):
            kind = spec.get("type", "system")
            target = spec.get("port") if kind == "port" else spec.get("unit")
            known[key] = [kind, target or key]
        else:
            known[key] = [spec[0], spec[1]]


# ── CLI ──────────────────────────────────────────────────────────────────────
def cli(argv):
    if argv[:1] == ["path"]:
        print(CONFIG_PATH)
        return 0
    if argv[:1] == ["list"]:
        cfg = load()
        known = known_map(cfg)
        enabled = enabled_set(cfg)
        print("config: %s" % CONFIG_PATH)
        for key in sorted(known):
            kind, target = known[key]
            print("  [%s] %-22s %-8s %s"
                  % ("x" if key in enabled else " ", key, kind, target))
        return 0
    if argv[:1] == ["detect"]:
        for key, kind, target in detect():
            print("  %-22s %-8s %s" % (key, kind, target))
        return 0
    if argv[:1] == ["enable"]:
        if len(argv) < 2:
            print("usage: hongyan-config enable NAME [KIND] [TARGET]"); return 2
        cfg = load()
        known = known_map(cfg)
        key = argv[1]
        known[key] = [argv[2] if len(argv) > 2 else known.get(key, ["system"])[0],
                      argv[3] if len(argv) > 3 else known.get(key, ["", key])[1]]
        apply_state(cfg, known, enabled_set(cfg) | {key})
        save(cfg)
        return 0
    if argv[:1] == ["disable"]:
        if len(argv) < 2:
            print("usage: hongyan-config disable NAME"); return 2
        cfg = load()
        known = known_map(cfg)
        apply_state(cfg, known, enabled_set(cfg) - {argv[1]})
        save(cfg)
        return 0
    print("usage: hongyan-config [list|detect|enable NAME [KIND] [TARGET]|"
          "disable NAME|path]\nno subcommand starts the interactive menu")
    return 2


# ── TUI ──────────────────────────────────────────────────────────────────────
def tui():
    cfg = load()
    known = known_map(cfg)
    sync_from_config(cfg, known)
    enabled = enabled_set(cfg)
    dirty = False

    def draw():
        os.system("cls" if IS_WINDOWS else "clear")
        star = _c("33", " *unsaved*") if dirty else ""
        print(_c("1", "hongyan — what may the bot see and touch?") + star)
        print(_c("3", "config: %s" % CONFIG_PATH))
        print()
        for i, key in enumerate(sorted(known), 1):
            kind, target = known[key]
            if key in enabled:
                mark, key_s = _c("32", "[x]"), key
            else:
                mark, key_s = _c("90", "[ ]"), _c("90", key)
            print("  %2d %s %-22s %-8s %s" % (i, mark, key_s, kind, target))
        print()
        print("  <number> toggle   r refresh (adds new finds, enabled)   "
              "n add by hand")
        print("  s save   q quit without saving")

    while True:
        draw()
        try:
            choice = input("> ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            choice = "q"
        if choice in ("q", "^c"):
            if dirty and not _confirm_discard():
                continue
            print("Bye! Unsaved changes discarded." if dirty else "Bye!")
            return
        if choice == "s":
            apply_state(cfg, known, enabled)
            save(cfg)
            dirty = False
            continue
        if choice == "r":
            fresh = 0
            for key, kind, target in detect():
                if key not in known:
                    known[key] = [kind, target]
                    enabled.add(key)
                    fresh += 1
            if fresh:
                dirty = True
                print(_c("32", "  %d new service(s) added and enabled" % fresh))
            else:
                print("  nothing new running")
            input("  enter to continue ")
            continue
        if choice == "n":
            parts = input("  name kind target: ").split()
            if len(parts) == 3:
                known[parts[0]] = [parts[1], parts[2]]
                enabled.add(parts[0])
                dirty = True
            continue
        if choice.isdigit() and 1 <= int(choice) <= len(known):
            key = sorted(known)[int(choice) - 1]
            if key in enabled:
                enabled.discard(key)
            else:
                enabled.add(key)
            dirty = True


def _confirm_discard():
    try:
        reply = input("  unsaved changes — discard? [y/N] ").strip().lower()
    except (KeyboardInterrupt, EOFError):
        return True
    return reply.startswith("y")


if __name__ == "__main__":
    sys.exit(tui() if len(sys.argv) <= 1 else cli(sys.argv[1:]))
