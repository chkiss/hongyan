#!/bin/bash
# Send a Signal message to the user from the "Claude (chau)" bot account.
# Usage: hongyan-me "message text"   |   echo "text" | hongyan-me
#
# Delegates to hongyan-send.py, which prefers the running daemon's JSON-RPC
# socket. The daemon holds an exclusive lock on the account, so a bare
# `signal-cli send` would fail while it is up.
set -euo pipefail

if [ "$#" -gt 0 ]; then
    exec /usr/bin/python3 "$HOME/.local/bin/hongyan-send.py" "$@"
else
    exec /usr/bin/python3 "$HOME/.local/bin/hongyan-send.py"
fi
