#!/bin/bash
set -uo pipefail

# These are exported before the library is sourced because the library reads
# XDG_RUNTIME_DIR to decide where the socket goes: cron gives us no session,
# so without this line the runtime dir would differ between a cron start and
# a hand start, and the two would fight over two different sockets.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

_hy_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [ -f "$_hy_dir/hongyan-lib.sh" ]; then
    . "$_hy_dir/hongyan-lib.sh"
elif [ -f "$HOME/.local/bin/hongyan-lib.sh" ]; then
    . "$HOME/.local/bin/hongyan-lib.sh"
else
    echo "hongyan-supervise: cannot find hongyan-lib.sh" >&2
    exit 1
fi

DIR="$HY_STATE_DIR"
SOCK="$HY_RUN_DIR/socket"
LOG="$HY_STATE_DIR/daemon.log"
LISTENER_LOG="$HY_STATE_DIR/listener.log"
DAEMON_PID="$HY_RUN_DIR/daemon.pid"
LISTENER_PID="$HY_RUN_DIR/listener.pid"

hongyan_dirs

if ! hongyan_alive "$DAEMON_PID" "daemon"; then
    rm -f "$SOCK"
    # signal-cli is a native-image binary that unpacks a ~174 MB libsignal
    # bundle into /tmp at startup and never removes it. Recycle restarts it
    # four times a day, so /tmp collected 48 orphans and filled the root
    # filesystem on 2026-08-30. TMPDIR does not move it — the native image
    # pins java.io.tmpdir to /tmp — so reap instead of redirect. Here is the
    # one moment that is provably safe: we are in the "daemon not alive"
    # branch, so no signal-cli process holds any of these, and the copy the
    # next line unpacks is created after the delete.
    rm -rf /tmp/libsignal*
    nohup "$HOME/.local/bin/signal-cli" --log-file "$DIR/cli.log" daemon \
        --socket "$SOCK" --receive-mode on-connection --no-receive-stdout \
        >> "$LOG" 2>&1 &
    echo $! > "$DAEMON_PID"
    for _ in $(seq 1 30); do
        [ -S "$SOCK" ] && break
        sleep 1
    done
    echo "$(date "+%F %T") daemon started pid $(cat "$DAEMON_PID")" >> "$LOG"
fi

if [ -S "$SOCK" ] && ! hongyan_alive "$LISTENER_PID" "hongyan_listener"; then
    nohup /usr/bin/python3 "$HOME/.local/bin/hongyan_listener.py" >> "$LISTENER_LOG" 2>&1 &
    echo $! > "$LISTENER_PID"
    echo "$(date "+%F %T") listener started pid $(cat "$LISTENER_PID")" >> "$LISTENER_LOG"
fi

for f in "$LOG" "$LISTENER_LOG"; do
    if [ -f "$f" ] && [ "$(wc -l < "$f")" -gt 1000 ]; then
        tail -n 300 "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    fi
done
