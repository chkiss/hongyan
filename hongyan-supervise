#!/bin/bash
set -uo pipefail

DIR="$HOME/.config/hongyan"
SOCK="$DIR/socket"
LOG="$DIR/daemon.log"
LISTENER_LOG="$DIR/listener.log"
DAEMON_PID="$DIR/daemon.pid"
LISTENER_PID="$DIR/listener.pid"

mkdir -p "$DIR"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

_hy_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [ -f "$_hy_dir/hongyan-lib.sh" ]; then
    . "$_hy_dir/hongyan-lib.sh"
elif [ -f "$HOME/.local/bin/hongyan-lib.sh" ]; then
    . "$HOME/.local/bin/hongyan-lib.sh"
else
    echo "hongyan-supervise: cannot find hongyan-lib.sh" >&2
    exit 1
fi

if ! hongyan_alive "$DAEMON_PID" "daemon"; then
    rm -f "$SOCK"
    nohup "$HOME/.local/bin/signal-cli" daemon \
        --socket "$SOCK" --receive-mode on-connection --no-receive-stdout \
        --log-file "$DIR/cli.log" \
        >> "$LOG" 2>&1 &
    echo $! > "$DAEMON_PID"
    for _ in $(seq 1 30); do
        [ -S "$SOCK" ] && break
        sleep 1
    done
    echo "$(date "+%F %T") daemon started pid $(cat "$DAEMON_PID")" >> "$LOG"
fi

if [ -S "$SOCK" ] && ! hongyan_alive "$LISTENER_PID" "hongyan_listener"; then
    nohup /usr/bin/python3 "$HOME/.local/bin/hongyan_listener.py" >> "$LISTENER_LOG" 2>&1 &
    echo $! > "$LISTENER_PID"
    echo "$(date "+%F %T") listener started pid $(cat "$LISTENER_PID")" >> "$LISTENER_LOG"
fi

for f in "$LOG" "$LISTENER_LOG"; do
    if [ -f "$f" ] && [ "$(wc -l < "$f")" -gt 1000 ]; then
        tail -n 300 "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    fi
done
