#!/usr/bin/env python3
"""signal-probe — functional health probe for the signal-cli daemon.

Opens the JSON-RPC socket and asks getUserStatus for the owner number: a
question only Signal's servers can answer. A half-open websocket (ESTAB in
ss, dead in reality — the 2026-08-23 silent failure mode) hangs here and
fails the probe, even though process checks and connection counts look fine.
Exit 0 = server roundtrip succeeded; exit 1 = no timely answer.
"""
import json
import os
import socket
import sys
import time
from pathlib import Path

_CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME")
                       or str(Path.home() / ".config"), "hongyan")
_STATE = os.path.join(os.environ.get("XDG_STATE_HOME")
                      or str(Path.home() / ".local/state"), "hongyan")


def _run_dir():
    """The runtime dir, resolved exactly as hongyan-lib.sh resolves it.

    cron has no session, so XDG_RUNTIME_DIR is unset there while an
    interactive shell has it. Falling straight through to the state dir is
    what makes this probe a liar: from cron it looked for the socket under
    ~/.local/state/hongyan/run while the daemon was listening on
    /run/user/<uid>/hongyan, so connect() failed instantly, the probe
    reported a dead daemon, and flap-guard recycled a healthy one every five
    minutes. The shell lib carries the same scar from the watchdog. The
    /run/user fallback belongs in both.
    """
    rt = os.environ.get("XDG_RUNTIME_DIR")
    if rt:
        return os.path.join(rt, "hongyan")
    user_run = "/run/user/%d" % os.getuid()
    if os.path.isdir(user_run):
        return os.path.join(user_run, "hongyan")
    return os.path.join(_STATE, "run")


_RUN = _run_dir()

CFG = json.loads(Path(_CONFIG).joinpath("config.json").read_text())
# The socket is derived, not configured — see the XDG note in the listener.
SOCK = os.path.expanduser(CFG.get("socket") or os.path.join(_RUN, "socket"))
OWNER = CFG["owner_number"]
TIMEOUT = 12

req = {"jsonrpc": "2.0", "id": "probe", "method": "getUserStatus",
       "params": {"recipient": OWNER}}

try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(TIMEOUT)
    s.connect(SOCK)
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    deadline = time.time() + TIMEOUT
    while time.time() < deadline:
        try:
            chunk = s.recv(4096)
        except socket.timeout:
            break
        if not chunk:
            break
        buf += chunk
        for line in buf.split(b"\n"):
            if not line.strip():
                continue
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") == "probe":
                sys.exit(0 if "result" in msg else 1)
    sys.exit(1)
except OSError:
    sys.exit(1)
