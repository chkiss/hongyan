#!/usr/bin/env bash
# hongyan-stt <audio-file>
#
# Transcribes one voice note to stdout. Runs ffmpeg and whisper-cli as
# short-lived processes: RAM is used while a note is being transcribed and
# released the moment it exits — nothing sits resident between messages.
#
# One-time setup on the server:
#   git clone https://github.com/ggml-org/whisper.cpp ~/whisper.cpp
#   cmake -S ~/whisper.cpp -B ~/whisper.cpp/build && cmake --build ~/whisper.cpp/build -j2
#   cp ~/whisper.cpp/models/ggml-tiny.en.bin ~/.config/hongyan/
#   ln -s ~/whisper.cpp/build/bin/whisper-cli ~/.local/bin/whisper-cli
# Then point config.json at this script:  "stt": {"command": "~/.local/bin/hongyan-stt"}
set -euo pipefail

WHISPER_BIN="${WHISPER_BIN:-$HOME/.local/bin/whisper-cli}"
MODEL="${HONGYAN_STT_MODEL:-$HOME/.config/hongyan/ggml-tiny.en.bin}"

[ -x "$WHISPER_BIN" ] || { echo "whisper-cli not found at $WHISPER_BIN" >&2; exit 3; }
[ -f "$MODEL" ]       || { echo "model not found at $MODEL" >&2; exit 3; }
[ -n "${1:-}" ]       || { echo "usage: hongyan-stt <audio-file>" >&2; exit 3; }

wav="$(mktemp --suffix=.wav)"
trap 'rm -f "$wav"' EXIT

# signal-cli delivers voice notes as ogg/opus; whisper wants 16 kHz mono WAV.
ffmpeg -v error -y -i "$1" -ar 16000 -ac 1 "$wav"
exec "$WHISPER_BIN" -m "$MODEL" -nt -np "$wav"   # -nt: no timestamps, -np: quiet
